[Unit]
Description=PokéDeck web service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pokedeck
Group=pokedeck
ExecStart=/usr/bin/pokedeck -config /etc/pokedeck/config.yaml
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=pokedeck
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
